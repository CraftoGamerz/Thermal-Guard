# NASA public South Asia downloads work without a key.
# Optional FIRMS Area API key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
HOST=127.0.0.1
PORT=4173
# Required when HOST is not loopback. Use a long random value, never a VITE_ variable.
WORKSPACE_TOKEN=
# Optional override; defaults to .venv/Scripts/python.exe on Windows, .venv/bin/python elsewhere.
PYTHON_BIN=
