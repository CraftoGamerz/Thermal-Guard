{
  "name": "thermalguard",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.mjs --dev",
    "build": "vite build",
    "build:pages": "vite build --base=/ThermalGuard/ --mode pages",
    "deploy:pages": "npm run build:pages && node scripts/deploy-pages.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "lint": "oxlint src/App.jsx src/main.jsx src/workspace server tests",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser-smoke.mjs",
    "test:earth": "node tests/earth-browser.mjs",
    "test:analysis": "node tests/analysis-browser.mjs",
    "test:model": "node scripts/test-model.mjs",
    "preview": "npm start"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "lucide-react": "1.41.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.0",
    "gh-pages": "6.3.0",
    "oxlint": "1.79.0",
    "playwright": "1.62.1",
    "vite": "8.2.2"
  }
}
